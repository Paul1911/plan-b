# =============================================================================
# 1Live Plan B - Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.

# -----------------------------------------------------------------------------
# Tidal (Phase 1 - Primary)
# -----------------------------------------------------------------------------
# No credentials needed! On first run, the program will print a URL.
# Open it in your browser, log in to Tidal, and the session is saved
# automatically for future runs.
#
# Optional: path to session file (default: .tidal_session.json)
# TIDAL_SESSION_FILE=.tidal_session.json

# -----------------------------------------------------------------------------
# Spotify (Phase 2 - Secondary)
# -----------------------------------------------------------------------------
# To use Spotify, you need a Spotify Developer App:
#
# 1. Go to https://developer.spotify.com/dashboard
# 2. Log in with your Spotify account
# 3. Click "Create App"
# 4. Fill in:
#    - App name: "1Live Plan B" (or anything you like)
#    - App description: "Playlist automation"
#    - Redirect URI: http://localhost:8888/callback
# 5. Click "Save"
# 6. On the app page, click "Settings"
# 7. Copy "Client ID" and "Client Secret" and paste below
#
# SPOTIFY_CLIENT_ID=your_client_id_here
# SPOTIFY_CLIENT_SECRET=your_client_secret_here
# SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# -----------------------------------------------------------------------------
# Headless / CI (GitHub Actions)
# -----------------------------------------------------------------------------
# Instead of the .tidal_session.json file, you can supply the whole session as
# JSON (e.g. a GitHub Actions secret). This overrides the file when set.
# Get it by running `python -m plan_b login` once, then copying the file content.
# TIDAL_SESSION_JSON={"token_type": "...", "access_token": "...", ...}

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
# Station timezone (playlist times are local to the station)
# TIMEZONE=Europe/Berlin

# Daily schedule time (HH:MM format, 24h) - only used by the `schedule` command
# SCHEDULE_TIME=09:00

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Fuzzy match threshold (0-100, higher = stricter matching)
# FUZZY_MATCH_THRESHOLD=75
